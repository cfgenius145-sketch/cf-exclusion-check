{
  "name": "cf-exclusion-check",
  "version": "1.0.0",
  "private": true,
  "description": "Pay-per-call healthcare exclusion screening API (x402 + MCP) on Cloudflare Workers",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply cf_exclusions --local",
    "migrate:remote": "wrangler d1 migrations apply cf_exclusions --remote",
    "seed:build": "node scripts/build-seed.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "@x402/paywall": "^2.25.0",
    "hono": "^4.6.14",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^22.20.2",
    "@x402/fetch": "^2.25.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  }
}
