{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-exclusion-check",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // cfsoft.us zone is active on Cloudflare's own nameservers, so this is a
  // native Workers Custom Domain rather than the droplet reverse-proxy plan
  // in docs/DOMAIN-MOVE.md (written for cfaisolutions.com, which had no zone
  // here). The workers.dev route stays live alongside this one.
  // workers_dev stays on: Bazaar's indexed resource URLs and any in-flight
  // caller still point at the workers.dev origin, so adding the custom domain
  // must not silently kill it (wrangler disables workers_dev by default the
  // moment a route is added).
  "workers_dev": true,
  "routes": [
    { "pattern": "exclusions.cfsoft.us", "custom_domain": true }
  ],

  // Rate limiting via the native binding rather than counting rows in D1.
  // Counting in D1 would cost a query on every request and, because request
  // logging is deferred through waitUntil, the count would lag behind reality
  // and under-enforce exactly when traffic spikes.
  //
  // `period` only accepts 10 or 60, so both limits are expressed per 60s:
  // free 10/min, paid 60/min.
  "unsafe": {
    "bindings": [
      {
        "name": "RL_FREE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RL_PAID",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 60, "period": 60 }
      },
      // Separate, lower bucket for /v1/batch: each call can fan out to up to
      // 14 D1 queries (measured worst case at 200 items, all distinct
      // identifiers), so 20/min caps per-caller D1 query fan-out at ~280/min
      // rather than reusing /v1/check's 60/min.
      {
        "name": "RL_BATCH",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf_exclusions",
      "database_id": "448328a8-0dae-4b08-81f3-2cf46fc00321",
      "migrations_dir": "migrations"
    }
  ],

  // "0 6 15 * *" monthly: merge that month's LEIE supplements (new exclusions
  //               + reinstatements). Small files, comfortably inside the limits.
  // "0 7 * * *"  daily: HEAD the 15.6MB active list and record whether upstream
  //               has moved past the loaded generation, so /v1/health can say
  //               a reseed is due instead of implying the data is current.
  //
  // There is deliberately NO full-list refresh cron. It is not achievable on
  // the free plan: oig.hhs.gov ignores Range requests (a byte-range request
  // returns all 15,608,468 bytes with no accept-ranges), so a chunked loader
  // cannot slice the file, and 10ms CPU per invocation cannot parse it whole.
  // The bulk generation is built by scripts/build-seed.mjs. See src/loader.ts.
  // "* 7-11 * * *" — state-exclusions import ticks, added 2026-09-15. CFAI's
  // export rebuilds at 07:15 UTC; this 5-hour, once-a-minute window (300
  // ticks) gives wide margin over the ~186 ticks a full 66,908-record load
  // needs at MAX_INSERTS_PER_TICK (state_import.ts) — unverified estimate,
  // to be measured for real on the preview deploy before this ships past G2.
  // A tick outside an in-progress load just checks the manifest sha256 and
  // returns "unchanged" — cheap, one fetch, no D1 write.
  "triggers": {
    "crons": ["0 6 15 * *", "0 7 * * *", "* 7-11 * * *"]
  },

  // LIVE ON BASE MAINNET. Payments here are real money.
  //
  // PAY_TO is a var, not a secret: a receiving address is public by nature (it
  // is published in every 402 challenge), and keeping it in config makes a
  // change to the payout destination reviewable in a diff rather than invisible
  // in a secret store.
  //
  // FACILITATOR_URL must stay on CDP. https://x402.org/facilitator is
  // testnet-only — its /supported endpoint does not list eip155:8453 — so
  // pointing back at it would make every paid request fail with
  // "Facilitator does not support exact on eip155:8453". CDP additionally
  // requires the CDP_API_KEY_ID / CDP_API_KEY_SECRET secrets; see src/cdp.ts.
  //
  // To return to testnet: NETWORK -> "eip155:84532" (CDP supports both).
  "vars": {
    "NETWORK": "eip155:8453",
    "PAY_TO": "0xCa28eb92657F8a81aFb5493b3a04A740B204d816",
    "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
    "LEIE_CSV_URL": "https://oig.hhs.gov/exclusions/downloadables/UPDATED.csv",
    "PRICE_CHECK": "$0.05",
    "PRICE_REPORT": "$0.50",
    "SERVICE_NAME": "CF Exclusion Check",
    // State Medicaid exclusion lists (2026-09-15). CFAI's export, rebuilt
    // daily at 07:15 UTC after its own rebuild_excl_index (06:55). Plain
    // body, no Content-Encoding — see state_import.ts's readWindow comment
    // on why that matters.
    "STATE_MANIFEST_URL": "https://cfai.app/exports/state-exclusions/manifest.json",
    "STATE_RECORDS_URL": "https://cfai.app/exports/state-exclusions/records.ndjson.gz"
  }
}
